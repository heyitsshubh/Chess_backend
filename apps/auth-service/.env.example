# Auth Service Environment Variables (example)

NODE_ENV=development
PORT=3001
SERVICE_NAME=auth-service

# Database
DATABASE_URL="postgresql://chess_admin:chess_password@localhost:5432/chess_auth_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT - Generate strong secrets with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Resend Email
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev

# App
APP_URL=http://localhost:3000
